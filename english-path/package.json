{
  "name": "english-path",
  "version": "0.1.0",
  "description": "English Path Cordis/Harness substrate bundle (LearnerStore + speech ports)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "persistence",
    "sidecar",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node --test dist/scripts/smoke.test.js",
    "test": "npm run smoke"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
